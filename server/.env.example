NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/codedrop

# "dev" trusts x-user-id. Use "firebase" before real users; refused when NODE_ENV=production.
AUTH_MODE=dev
# Comma-separated user ids allowed to use /admin routes
ADMIN_USER_IDS=

# Firebase phone auth (AUTH_MODE=firebase). Prefer GOOGLE_APPLICATION_CREDENTIALS pointing at a service-account JSON file.
FIREBASE_PROJECT_ID=
# Optional alternative to ADC: entire service-account JSON as a single line. Never commit the real value.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Reader account for public tipster channels — from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Produced by `npm run telegram:login`. Treat like a password.
TELEGRAM_SESSION=
TELEGRAM_JOIN_PER_RUN=10

# Confirm in browser dev tools before going live (see src/core/bookies/sportybet.ts)
SPORTYBET_SHARE_URL=https://www.sportybet.com/api/ng/orders/share/{code}
# Unverified until a fixture is captured — leave blank to keep them unregistered.
BET9JA_SHARE_URL=
BETKING_SHARE_URL=
MSPORT_SHARE_URL=
BOOKIE_MIN_INTERVAL_MS=1500
# Comma-separated bookies whose resolvers may run. Unverified resolvers stay off in production.
ENABLED_BOOKIES=sportybet

# api-sports.io — without this, settlement stays pending (manual admin settle still works)
API_FOOTBALL_KEY=
