NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/codedrop

# dev trusts an x-user-id header. Switch to firebase before real users.
AUTH_MODE=dev
# Comma-separated user ids allowed to use /admin routes
ADMIN_USER_IDS=

# Reader account for public tipster channels — from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Produced by `npm run telegram:login`. Treat like a password.
TELEGRAM_SESSION=
TELEGRAM_JOIN_PER_RUN=10

# Confirm in browser dev tools before going live (see src/core/bookies/sportybet.ts)
SPORTYBET_SHARE_URL=https://www.sportybet.com/api/ng/orders/share/{code}
BOOKIE_MIN_INTERVAL_MS=1500
